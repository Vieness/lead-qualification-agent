{
  "name": "@lead-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "prompts"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "start:prod": "node dist/db/migrate.js && node dist/db/seed.js && node dist/index.js",
    "test:live": "vitest run --config vitest.live.config.ts",
    "agent": "tsx src/cli.ts",
    "eval": "tsx src/eval/cli.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.13",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "openai": "^7.45.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
