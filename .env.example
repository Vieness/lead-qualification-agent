# Copy to .env (`make setup` does it) and change what you need.
# Every value below is the default; empty values count as unset.

# --- Server ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Optional: require an `x-api-key` header on every endpoint except /health, /openapi.json
# and /docs (at least 16 characters). Empty = no key (demo mode)
API_KEY=

# --- Database ---
# Matches docker-compose.yml (`make db-up`). Empty = in-memory PGlite, lost on restart.
# In Docker the API gets its own DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgres://lead_agent:lead_agent@localhost:5432/lead_agent
DB_POOL_SIZE=5
# Portfolio case studies loaded by `make db-seed` (empty = data/portfolio)
PORTFOLIO_DIR=

# --- LLM provider: mock | anthropic | openai-compatible ---
# "mock" needs no API key and gives deterministic answers (tests, CLI, eval, demo).
LLM_PROVIDER=mock

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Retry a refused request on another Claude model inside the same call
ANTHROPIC_FALLBACKS=true

# OpenAI-compatible: OpenAI, Groq, OpenRouter, Gemini, Ollama (examples in the README).
# Free option used for the real-model eval (docs/eval-groq.md):
#   LLM_PROVIDER=openai-compatible
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   OPENAI_API_KEY=<your Groq key>
#   OPENAI_REASONING_EFFORT=auto
OPENAI_API_KEY=
OPENAI_MODEL=
# Empty = api.openai.com
OPENAI_BASE_URL=
# auto = pass each call's effort as reasoning_effort (gpt-oss, o-series): 30–40% fewer
# output tokens on Groq. Keep off for models without reasoning; they may reject the field
OPENAI_REASONING_EFFORT=off

# --- Agent limits ---
# Supervisor planning steps per lead; past it the lead goes to human review
AGENT_MAX_STEPS=12
# Wall-clock budget per lead; when it runs out the lead goes to human review
AGENT_RUN_BUDGET_MS=90000
# Portfolio searches the matching agent may plan (1 saves tokens)
AGENT_MAX_SEARCH_TURNS=3
# Draft rewrites after a policy violation
AGENT_MAX_REWRITES=1
# Leads with a budget at or above this value (USD) always require human approval
HUMAN_APPROVAL_BUDGET_USD=50000

# --- LLM reliability ---
# Timeout of one model call attempt
AGENT_LLM_TIMEOUT_MS=30000
# Retries for invalid model output and for transient errors (timeouts, 5xx, network)
AGENT_MAX_RETRIES=2
# First retry delay; doubles each attempt (+ jitter), capped at 8 s
LLM_RETRY_BASE_MS=500
# 429s mean "wait", not "broken": they get more retries
LLM_RATE_LIMIT_RETRIES=5
# At most this many model calls run at once in the process
LLM_MAX_CONCURRENCY=4
# A 429 asking to wait longer than this fails at once (quota_exhausted) instead of retrying
LLM_MAX_RETRY_AFTER_MS=30000

# --- Debugging ---
# Also write every run trace to <TRACE_DIR>/<traceId>.json (e.g. traces). Empty = off
TRACE_DIR=
